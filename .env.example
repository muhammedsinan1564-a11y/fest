# Festize — environment configuration template
# Copy this file to `.env` and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# ---------------------------------------------------------------------------
# Optional: Supabase cloud workspace snapshots
# When both values are set, the Tabulation Toolkit gains
# "Save to Cloud" / "Load from Cloud" buttons that sync the entire
# Festize workspace to the `festize_workspace_snapshots` table.
# Leave blank to run Festize fully offline (LocalStorage only).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Example (from `supabase start` local CLI):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
